{
  "name": "tasklist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prod": "vite --mode production",
    "dev": "vite --mode development",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "client": "openapi-generator-cli generate -i ../../taskmanager/openapi.json -o src/client/generated/taskmanager -g typescript-axios",
    "api": "openapi-generator-cli generate -i ../../tasklistApi/openapi.yaml -o src/client/generated/api -g typescript-angular --global-property models --additional-properties=stringEnums=true,supportsES6=true,npmVersion=10.8.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/material-renderers": "^3.8.0",
    "@jsonforms/react": "^3.8.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "form-data": "^4.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-json-view": "^1.21.3",
    "tss-react": "^4.9.21"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "yarn@4.4.0"
}
