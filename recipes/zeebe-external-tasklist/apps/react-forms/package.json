{
  "name": "react-forms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && yarn copy",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "api": "rimraf src/api/generated && openapi-generator-cli generate -i ../../processes/order/openapi.json -o src/api/generated -g typescript-angular --global-property models --additional-properties=stringEnums=true,supportsES6=true,npmVersion=10.8.2",
    "copy": "copyfiles -f dist/index.html ../../processes/order/src/main/resources/forms",
    "html2String": "node scripts/html2String.cjs",
    "eslint": "eslint --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tss-react": "^4.9.21"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@types/copyfiles": "^2",
    "@types/eslint__js": "^9.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "copyfiles": "^2.4.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "packageManager": "yarn@4.3.1"
}
